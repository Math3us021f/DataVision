# Credenciais de manutenção/superusuário do Postgres (não usadas pela aplicação, só para conexão manual/DBeaver)
POSTGRES_USER=datavision_app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=datavision

# Credenciais que a aplicação realmente usa: privilégio limitado, não é superusuário
APP_DB_USER=datavision_app_limited
APP_DB_PASSWORD=troque-esta-senha-tambem

SECRET_KEY=troque-esta-chave-secreta
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-tambem

# MinIO local de dev — credenciais próprias, NUNCA as mesmas da produção
MINIO_ROOT_USER=troque-este-usuario
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem
MINIO_BUCKET=datavision-datasets-dev
