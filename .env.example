# Credenciais de manutenção/superusuário do Postgres (não usadas pela aplicação, só para conexão manual/DBeaver)
POSTGRES_USER=datavision_app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=datavision

# Credenciais que a aplicação realmente usa: privilégio limitado, não é superusuário
APP_DB_USER=datavision_app_limited
APP_DB_PASSWORD=troque-esta-senha-tambem

SECRET_KEY=troque-esta-chave-secreta
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-tambem

# MinIO local de dev — credenciais próprias, NUNCA as mesmas da produção
MINIO_ROOT_USER=troque-este-usuario
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem
MINIO_BUCKET=datavision-datasets-dev

# Produção (opcional; valores padrão servem para desenvolvimento)
# APP_ENV=production             # desliga /docs, /redoc e /openapi.json
# SESSION_COOKIE_SECURE=true     # ligar quando o acesso for por HTTPS

# E-mail do login em dois passos. Em desenvolvimento NÃO é preciso configurar nada: os e-mails vão para o
# Mailpit (http://localhost:8025) e nada sai da máquina. Para testar o envio real em desenvolvimento
# (e só nesse caso; não rode os testes de interface enquanto estiver definido):
# DEV_SMTP_HOST=smtp.gmail.com
# DEV_SMTP_PORT=587
# DEV_SMTP_USER=
# DEV_SMTP_PASSWORD=
# DEV_SMTP_FROM=
