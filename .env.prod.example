# Modelo do arquivo .env.prod do SERVIDOR (copie para .env.prod, preencha e use chmod 600).
# Nunca versionar o arquivo preenchido. Gere segredos novos, diferentes dos de desenvolvimento
# e diferentes de qualquer credencial já existente no servidor, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

APP_VERSION=2026-11-02

# Interface onde a aplicação escuta no servidor (padrão: só a própria VM) e a porta.
# APP_BIND_ADDRESS=127.0.0.1
# APP_PORT=8000
# SESSION_COOKIE_SECURE=true   # ligar quando o acesso for por HTTPS

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=datavision
APP_DB_USER=datavision_app_limited
APP_DB_PASSWORD=

SECRET_KEY=
# Endereços pelos quais a aplicação é acessada (separados por vírgula): o Django recusa qualquer outro.
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_USERNAME=
ADMIN_PASSWORD=

# MinIO que já existe no servidor: endpoint alcançável a partir do container e as chaves do
# USUÁRIO DE SERVIÇO restrito ao bucket do DataVision (não as credenciais root).
# MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=datavision-datasets

# E-mail do login em dois passos (obrigatório em produção para quem tem e-mail cadastrado: sem SMTP
# funcionando, essas contas não conseguem entrar). Use uma conta dedicada ao sistema e, no Gmail, uma
# senha de aplicativo (nunca a senha da conta). Porta 587 = STARTTLS, 465 = SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
